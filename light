<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Joining Roblox Private Server</title>
    <script>
        window.onload = function()
        {
            const params = new URLSearchParams(window.location.search);
            const code = params.get('code');
            const type = params.get('type') || 'Server';

            if (code)
            {
                window.location.href = `roblox://navigation/share_links?code=${code}&type=${type}`;
            }
            else
            {
                document.body.textContent = "Error: Missing Server Code.";
            }
        };
    </script>
</head>
<body></body>
</html>
